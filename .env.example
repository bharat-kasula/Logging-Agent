# Matilda-Log / Logging-Agent — copy to .env and edit

# --- Loki (live logs) ---
LOKI_URL=https://loki.example.com
# Basic auth (optional)
LOKI_USERNAME=
LOKI_PASSWORD=
# Or Bearer token (optional; takes precedence if set)
LOKI_TOKEN=
# Grafana multi-tenant header (optional)
LOKI_ORG_ID=
# Label key used to filter customers (match Grafana Explore)
DEFAULT_CUSTOMER_LABEL=customer_id
# Base stream selector — match your jobs in Grafana
# e.g. job=matilda-install and job=matilda-success
LOKI_STREAM_SELECTOR={job=~"matilda-install|matilda-success"}
LOKI_QUERY_LIMIT=100
LOKI_TIMEOUT_SECONDS=30

# --- Ollama (local, LAN, or tunnel URL) ---
USE_OLLAMA=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Or public tunnel, e.g. https://xxxx.trycloudflare.com
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.2

# --- Agent ---
DEFAULT_LOOKBACK=24h
MAX_LOG_LINES_TO_LLM=80

# --- Gradio UI ---
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# --- Local demo vs live Loki ---
# failure = Amerihealth local file | success = Siemens local file | off = real Loki
SIMULATION_DEFAULT_MODE=failure
# true = never call Loki (local data/ only); false = query live Loki
LOCAL_LOGS_ONLY=true

# --- Debug ---
DEBUG=false
